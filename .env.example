# Copie este archivo a .env y complete los valores. .env NUNCA se sube a Git.

COMPOSE_PROJECT_NAME=seguimiento-sgred

# Puertos publicados en 127.0.0.1 (elija puertos libres en su equipo)
SGRED_WEB_PUERTO=3310
SGRED_API_PUERTO=4310
SGRED_DB_PUERTO=55450

# Base de datos propia de este proyecto (no es la de INFOGRED)
POSTGRES_DB=seguimiento_sgred
POSTGRES_USER=sgred
POSTGRES_PASSWORD=cambie-esta-clave

# Carpeta privada con los documentos y las importaciones, FUERA del repositorio.
# Debe contener: contrataciones/  (PDF y Excel originales)  e  importaciones/  (JSON de importación)
SGRED_PRIVADOS_DIR=../seguimientoSGRED-privado

# Cuenta autorizada: id numérico de la tabla tbl_usuarios (lo imprime `npm run usuarios:crear`).
# Vacío = el módulo queda cerrado para todos.
SEGUIMIENTO_USUARIO_ID=

# Sesión
SEGUIMIENTO_SESION_HORAS=8
# true cuando se publique detrás de HTTPS
SEGUIMIENTO_COOKIE_SEGURA=false

# Sincronización de fuentes en minutos (5 a 1440; 0 la desactiva)
SEGUIMIENTO_SYNC_MINUTOS=30

# Google Drive (solo lectura). Secretos solo en .env; vacío = Drive sin configurar.
SEGUIMIENTO_DRIVE_ROOT_ID=
SEGUIMIENTO_DRIVE_CLIENT_ID=
SEGUIMIENTO_DRIVE_CLIENT_SECRET=
# Ruta (dentro del contenedor) del token de lectura generado por `contratacion:drive-vincular`
SEGUIMIENTO_DRIVE_TOKEN_FILE=/privados/.drive-token.json
SEGUIMIENTO_DRIVE_ABRIR_DIRECTO=false
# Segundos que se reutiliza la verificación de un archivo en la raíz autorizada (0 la desactiva)
SEGUIMIENTO_DRIVE_CACHE_SEGUNDOS=10

# Claude API: solo backend. Se carga en el servidor con scripts/cargar-clave-claude.ps1 (entrada oculta); no la escriba aquí.
ANTHROPIC_API_KEY=
# Procesamiento automático con IA (índice y sincronización). PAUSADO por defecto: false. Active con true solo tras validar el piloto.
SEGUIMIENTO_CLAUDE_AUTOMATICO=false
SEGUIMIENTO_CLAUDE_MODELO=
SEGUIMIENTO_CLAUDE_MAX_LLAMADAS_DIA=50
SEGUIMIENTO_CLAUDE_MAX_TOKENS_ENTRADA=12000
SEGUIMIENTO_CLAUDE_MAX_TOKENS_SALIDA=1500
# Documentos interpretados por cada actualización (tope por ejecución) y páginas de OCR por documento
SEGUIMIENTO_CLAUDE_MAX_DOCS_EJECUCION=10
SEGUIMIENTO_OCR_MAX_PAGINAS_IA=6
# Opcional: tarifa en USD por millón de tokens para estimar el costo (sin ella solo se registran tokens)
SEGUIMIENTO_CLAUDE_USD_MTOK_ENTRADA=
SEGUIMIENTO_CLAUDE_USD_MTOK_SALIDA=
